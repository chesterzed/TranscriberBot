# === Telegram ===
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Локальный Bot API сервер (для файлов больше 20 МБ) ---
# Публичный api.telegram.org отдаёт ботам файлы только до 20 МБ. Чтобы принимать
# большие файлы (до 2000 МБ), поднимите локальный telegram-bot-api сервер и укажите:
#   TELEGRAM_API_BASE_URL=http://127.0.0.1:8081/bot
#   TELEGRAM_API_BASE_FILE_URL=http://127.0.0.1:8081/file/bot
#   TELEGRAM_LOCAL_MODE=true   # если сервер запущен с флагом --local
# Оставьте пустыми, чтобы использовать публичный api.telegram.org.
TELEGRAM_API_BASE_URL=
TELEGRAM_API_BASE_FILE_URL=
TELEGRAM_LOCAL_MODE=false

# === Whisper (faster-whisper) ===
# Размер модели: tiny | base | small | medium | large-v3
# large-v3 — самое высокое качество (нужна хорошая видеокарта/много RAM)
# small / medium — хороший баланс для CPU
WHISPER_MODEL=small
# Устройство: cpu | cuda
WHISPER_DEVICE=cpu
# Тип вычислений: int8 (CPU), float16 (GPU), int8_float16 и т.д.
WHISPER_COMPUTE_TYPE=int8
# Язык распознавания. Пусто = автоопределение. Например: ru, en
WHISPER_LANGUAGE=

# === Ollama (локальная LLM) ===
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5
# Системный промпт для LLM
OLLAMA_SYSTEM_PROMPT=Ты дружелюбный ассистент. Отвечай кратко и по делу на языке пользователя.
# Сколько последних сообщений хранить в контексте диалога (на чат)
HISTORY_LIMIT=10

# === Прокси (Throne) ===
# Весь внешний трафик (Telegram, скачивание весов Whisper) идёт через прокси.
# Ollama на localhost всегда ходит напрямую, в обход прокси.
# Оставьте пустым, чтобы отключить прокси.
PROXY_URL=socks5://127.0.0.1:2080
# Хосты в обход прокси (Ollama и прочий localhost)
NO_PROXY=localhost,127.0.0.1

# === Прочее ===
# Максимальный размер файла в МБ.
# Публичный Bot API — жёсткий предел ~20. Локальный сервер — до 2000.
MAX_FILE_MB=2000

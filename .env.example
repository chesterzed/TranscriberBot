# === Telegram ===
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-xxxxxxxxxxxxxxxxxxxxxxxx

# === Whisper (faster-whisper) ===
# Размер модели: tiny | base | small | medium | large-v3
# large-v3 — самое высокое качество (нужна хорошая видеокарта/много RAM)
# small / medium — хороший баланс для CPU
WHISPER_MODEL=small
# Устройство: cpu | cuda
WHISPER_DEVICE=cpu
# Тип вычислений: int8 (CPU), float16 (GPU), int8_float16 и т.д.
WHISPER_COMPUTE_TYPE=int8
# Язык распознавания. Пусто = автоопределение. Например: ru, en
WHISPER_LANGUAGE=

# === Ollama (локальная LLM) ===
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5
# Системный промпт для LLM
OLLAMA_SYSTEM_PROMPT=Ты дружелюбный ассистент. Отвечай кратко и по делу на языке пользователя.
# Сколько последних сообщений хранить в контексте диалога (на чат)
HISTORY_LIMIT=10

# === Прочее ===
# Максимальный размер файла в МБ (Bot API ограничивает загрузку ~20 МБ)
MAX_FILE_MB=20
